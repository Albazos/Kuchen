  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background: #23262d;
    color: #e8edf5;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QFrame#fraSidebar {
    background: #1b2430;
    border-radius: 18px;
}

QFrame#fraClassCard {
    background: #26364a;
    border-radius: 14px;
}

QFrame#fraToolbarCard, QFrame#fraTableCard {
    background: #2b3038;
    border: 1px solid #3b4452;
    border-radius: 16px;
}

QPushButton {
    border: none;
    border-radius: 10px;
    background: #394352;
    color: #eef4fb;
    padding: 10px 14px;
}

QPushButton#pbnAddEntry {
    background: #2f6ea5;
    color: white;
    font-weight: 700;
}

QPushButton#pbnSendMail {
    background: #3e7fba;
    color: white;
    font-weight: 700;
}

QPushButton#pbnOpenMailList, QPushButton#pbnImport, QPushButton#pbnSave, QPushButton#pbnChangeClass {
    background: #26364a;
    color: white;
}

QLineEdit, QComboBox {
    background: #1f2329;
    color: #eef4fb;
    border: 1px solid #465263;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #3e7fba;
}

QLabel#lblWindowTitle {
    color: #7db2e3;
    font-size: 20pt;
    font-weight: 700;
    background: transparent;
}

QLabel#lblSidebarTitle {
    color: white;
    font-size: 22pt;
    font-weight: 700;
    background: transparent;
}

QLabel#lblWindowSubtitle, QLabel#lblTableHint, QLabel#lblTableMeta {
    color: #97a3b6;
    background: transparent;
}

QLabel#lblSidebarSubtitle, QLabel#lblSidebarSectionSort {
    color: rgba(255,255,255,180);
    background: transparent;
}

QLabel#lblSidebarActiveClassCaption, QLabel#lblActiveClassName, QLabel#lblTableTitle {
    background: transparent;
}

QTableView {
    background: #2f343d;
    alternate-background-color: #313741;
    border: none;
    color: #e8edf5;
    gridline-color: #404958;
    selection-background-color: #355f8c;
    selection-color: white;
}

QHeaderView::section {
    background: #353c48;
    color: #f2f6fb;
    border: none;
    padding: 8px;
    font-weight: 700;
}</string>
